S3_PROVIDER=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# R2 object Cache-Control metadata. rclone sends this with --header-upload.
# Cloudflare Cache uses it for edge TTL. Leave empty to omit the header.
CACHE_CONTROL=public, max-age=3600

# Set to 1 once after changing CACHE_CONTROL so existing objects are re-uploaded.
# CACHE_CONTROL_REUPLOAD=1
